print "File: test_166_sort_negative.we"
let values = [-1, -9, 3, 0, -4, 8]
let ordered = sort(values)
if ordered[0] == -9 { print "PASS: sort negative minimum" } else { print "FAIL: sort negative minimum" }
if ordered[5] == 8 { print "PASS: sort positive maximum" } else { print "FAIL: sort positive maximum" }
