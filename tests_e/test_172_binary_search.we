print "File: test_172_binary_search.we"
func binary_search(values, target) {
    let lo = 0
    let hi = len(values) - 1
    while lo <= hi {
        let mid = floor((lo + hi) / 2)
        if values[mid] == target { return mid }
        if values[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}
let values = [1, 3, 5, 7, 9, 11, 13]
if binary_search(values, 9) == 4 { print "PASS: binary search found" } else { print "FAIL: binary search found" }
if binary_search(values, 8) == -1 { print "PASS: binary search missing" } else { print "FAIL: binary search missing" }
print "test_172 done"
